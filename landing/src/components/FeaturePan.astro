---
import { Image } from 'astro:assets';
import prometheusPainting from '../assets/prometheus-painting.png';
import worktreeDark from '../assets/screenshots/workbench-screenshot.png';
import worktreeLight from '../assets/screenshots/workbench-screenshot-light.png';
import fileEditorDark from '../assets/screenshots/screenshot-session-restore.png';
import fileEditorLight from '../assets/screenshots/screenshot-git-diff-light.png';
import cmdPaletteDark from '../assets/screenshots/screenshot-command-palette.png';
import cmdPaletteLight from '../assets/screenshots/screenshot-command-palette-light.png';
import gitDiffDark from '../assets/screenshots/screenshot-git-diff.png';
import gitDiffLight from '../assets/screenshots/screenshot-session-restore-light.png';

const tabs = [
  { label: 'WORKTREES',   imgDark: worktreeDark,   imgLight: worktreeLight   },
  { label: 'FILE EDITOR', imgDark: fileEditorDark, imgLight: fileEditorLight },
  { label: 'CMD PALETTE', imgDark: cmdPaletteDark, imgLight: cmdPaletteLight },
  { label: 'GIT DIFF',   imgDark: gitDiffDark,    imgLight: gitDiffLight    },
];

const id = `feature-pan-${Math.random().toString(36).slice(2, 7)}`;
---

<div class="w-full" id={id}>
  <!-- Tabs -->
  <div class="flex gap-3 max-w-2xl mx-auto sm:px-0 px-4 mb-1.5 font-mono text-[10px] tracking-[0.08em] flex-wrap justify-center" style="position:relative;z-index:1;">
    {tabs.map((t, i) => (
      <button
        class="tab-btn shrink-0 cursor-pointer select-none transition-colors text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))]"
        data-index={i}
      >
        {t.label}
      </button>
    ))}
  </div>
  <!-- Painting background + browser -->
  <div class="p-4 sm:p-6 overflow-hidden" style="position:relative;">
    <Image
      src={prometheusPainting}
      alt=""
      format="webp"
      aria-hidden="true"
      style="position:absolute;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;object-position:center;"
    />
    <div class="w-full rounded-[6px] shadow-2xl" style="position:relative;z-index:2;">
      <div class="w-full rounded-[6px] overflow-hidden isolate">
      <div class="flex items-center gap-2 px-3 py-1.5 bg-muted border-b border-border">
        <div class="flex gap-1.5 shrink-0" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57] border border-black/10"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e] border border-black/10"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#28c840] border border-black/10"></span>
        </div>
        <div class="flex-1 flex items-center gap-1.5 bg-background border border-border rounded-[4px] px-2 py-0.5">
          <svg width="9" height="9" viewBox="0 0 16 16" fill="none" class="shrink-0 opacity-40"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/><path d="M8 4v4l2.5 2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <span class="font-mono text-[9px] text-foreground">localhost:4739</span>
        </div>
      </div>
      <!-- overflow-hidden clips screenshot to frame bottom radius -->
      <div class="w-full overflow-hidden rounded-b-[6px]">
        {tabs.map((t, i) => (
          <div
            class={`tab-img w-full block ${i === 0 ? '' : 'hidden'}`}
            data-index={i}
          >
            <Image src={t.imgDark} alt={t.label} format="webp" class="w-full h-auto hidden dark:block" />
            <Image src={t.imgLight} alt={t.label} format="webp" class="w-full h-auto block dark:hidden" />
          </div>
        ))}
      </div>
      </div>
    </div>
  </div>
</div>


<script define:vars={{ id }}>
  const root = document.getElementById(id);
  const btns = root.querySelectorAll('.tab-btn');
  const imgs = root.querySelectorAll('.tab-img');

  function activate(idx) {
    btns.forEach((b, i) => {
      b.style.color = i === idx ? 'hsl(var(--foreground))' : '';
      b.style.textDecoration = i === idx ? 'underline' : '';
    });
    imgs.forEach((img, i) => img.classList.toggle('hidden', i !== idx));
  }

  activate(0);
  btns.forEach(btn => btn.addEventListener('click', () => activate(Number(btn.dataset.index))));
</script>
